{
  "name": "unfold-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Understand a change, investigate its source, and review it deliberately.",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "unfold": "bin/unfold.mjs"
  },
  "scripts": {
    "unfold": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts serve",
    "connector": "tsx src/cli.ts connector",
    "web:dev": "vite --host 127.0.0.1",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/copy-skills.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "commander": "^14.0.0",
    "fastify": "^5.6.0",
    "picomatch": "^4.0.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "smol-toml": "^1.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
